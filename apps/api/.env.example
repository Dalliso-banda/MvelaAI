PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- AI ---
# Meta Muse is the only model Mvela uses. Leave META_API_KEY empty to run the built-in rules agent (no external calls).
META_API_KEY=
META_MODEL=muse-spark-1.1
# Three Muse agents per message: triage, specialist (tools), reviewer. Set false for one call per message (faster, cheaper).
MULTI_AGENT=true
# Optional: use a different Meta model for the two helper agents
# META_TRIAGE_MODEL=
# META_REVIEW_MODEL=

# --- Demo business ---
BUSINESS_NAME=Demo Bank Zambia
# Minutes of agent time assumed per routine query (used for the "hours saved" estimate)
HANDLE_MINUTES=6

# --- Security ---
# true = OTP codes are shown in the chat (no SMS provider yet). MUST be false in production.
OTP_DEMO=true
# Dashboard sign-in. The first owner account is created from these on first start.
# If ADMIN_PASSWORD is empty or under 8 characters, a random one is printed once in the API log.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: otherwise a secret is generated and stored in the database
JWT_SECRET=
# Public URL of this API, used in the embed snippet (e.g. https://api.yourdomain.com)
PUBLIC_API_URL=

# --- Data ---
# DB_FILE=./data/mvela.db
SEED_HISTORY=true
# CHAT_RATE_LIMIT=30   # chat messages per minute per IP

# ---- Connectors, queue, OTP delivery (see docs/CONNECTORS.md) ----
# BANK_MODE=demo uses the local demo data. http calls the bank's REST API.
BANK_MODE=demo
BANK_API_URL=http://localhost:4100
BANK_API_KEY=dev-bank-key
# OTP_CHANNEL: demo (code shown in chat, dev only) | email | sms | email,sms
OTP_CHANNEL=demo
# AT_API_KEY=
# AT_USERNAME=
# AT_SENDER_ID=
# RESEND_API_KEY=
# OTP_EMAIL_FROM=Mvela AI <onboarding@resend.dev>
# QUEUE_CONCURRENCY=4
# JOB_TIMEOUT_MS=8000

# Voice (Meta Muse Voice Transcribe, uses META_API_KEY)
# VOICE_LANGUAGES=English   # optional hint, comma separated; leave empty to auto-detect
# META_STT_MODEL=muse-voice-transcribe-1.0
